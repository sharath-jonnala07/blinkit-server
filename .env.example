# Groq API Key (https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Render / Server Port (default 8000)
PORT=8000

# Allowed Origins for CORS (comma separated or * for all)
ALLOWED_ORIGINS=*

# Render external URL for keep-alive self ping (automatically set by Render in production)
RENDER_EXTERNAL_URL=
